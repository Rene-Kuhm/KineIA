# KineIA Environment Variables

# Deployment
DOMAIN=your-domain.com
LETSENCRYPT_EMAIL=your-email@example.com
BACKUP_RETENTION_DAYS=7

# Database
DB_PASSWORD=changeme_secure_password
DATABASE_URL=postgresql://kineia:${DB_PASSWORD}@postgres:5432/kineia

# Qdrant
# Existing deployments must be inventoried and snapshotted before changing this image.
# Host preflight: cd backend; uv run --no-sync python scripts/qdrant_preflight.py
# Explicit provisioning: uv run --project backend --no-sync python backend/scripts/provision_hybrid.py
QDRANT_IMAGE=qdrant/qdrant:v1.18.2
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=kineia_knowledge
QDRANT_HYBRID_COLLECTION=kineia_knowledge_v2
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_SPARSE_VECTOR_NAME=sparse

# LLM Providers
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OLLAMA_BASE_URL=http://ollama:11434
LLM_PROVIDER=deepseek

# Auth
JWT_SECRET=changeme_jwt_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# App
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
